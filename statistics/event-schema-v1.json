{
  "event": "quiz_completed",
  "schemaVersion": 1,
  "fields": {
    "attemptId": "unique attempt identifier",
    "completedAt": "ISO 8601 completion timestamp",
    "durationSeconds": "seconds from start to completion",
    "route": "public quiz route without origin",
    "client": "client id, slug and name",
    "period": "year and month",
    "quiz": "quiz id, slug and title",
    "score": "correct, wrong, total and percent",
    "answers": "question id, selected answer, correct answer and correctness"
  }
}
